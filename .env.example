# MedRelief (Campus Edition) - Environment Configuration

# Supabase Cloud Database & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Twilio SMS Integration (Optional for live SMS delivery; simulation works out-of-the-box)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend Email Integration (Optional for live email delivery; simulation works out-of-the-box)
RESEND_API_KEY=

